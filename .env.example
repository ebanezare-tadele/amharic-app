# Copy to .env.local (gitignored) for local dev, and set the same two
# values in your hosting provider's environment variables for the
# deployed site. Without these, shared "Everyone" recordings fall back to
# this browser's own localStorage instead of syncing across devices.
# See README.md "Setting up Supabase" for how to get these values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
